        <mxCell id="chip3" value="&lt;span style=&quot;font-size:9.5px;color:#3b5b8c&quot;&gt;视盘视杯分割&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef3fb;strokeColor=#c5d5ee;" vertex="1" parent="1"><mxGeometry x="482" y="142" width="100" height="22" as="geometry" /></mxCell>
        <mxCell id="chip4" value="&lt;span style=&quot;font-size:9.5px;color:#3b5b8c&quot;&gt;REFUGE&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef3fb;strokeColor=#c5d5ee;" vertex="1" parent="1"><mxGeometry x="590" y="142" width="62" height="22" as="geometry" /></mxCell>
        <mxCell id="div2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#e6e6e6;" vertex="1" parent="1"><mxGeometry x="294" y="180" width="642" height="1" as="geometry" /></mxCell>
        <mxCell id="s1h" value="① 一句话" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1a1a1a;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="294" y="192" width="642" height="20" as="geometry" /></mxCell>
        <mxCell id="s1" value="用 YOLOv7 检测视盘/视杯并回归椭圆参数，直接给出 vCDR，无需像素级掩膜。" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="294" y="212" width="642" height="34" as="geometry" /></mxCell>
        <mxCell id="s3h" value="③ 方法" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1a1a1a;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="294" y="256" width="642" height="20" as="geometry" /></mxCell>
        <mxCell id="s3" value="两阶段：YOLOv7 定位 ROI → 边界回归 + 椭圆拟合；再做跨族群校准（REFUGE → 本地医院）。" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="294" y="276" width="642" height="34" as="geometry" /></mxCell>
        <mxCell id="s5h" value="⑤ 结果" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1a1a1a;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="294" y="320" width="642" height="20" as="geometry" /></mxCell>
        <mxCell id="tb0" value="&lt;span style=&quot;font-size:9.5px;color:#777777&quot;&gt;OD Dice&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;color:#1f4e8c&quot;&gt;0.9645&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fcfcfc;strokeColor=#d9d9d9;" vertex="1" parent="1"><mxGeometry x="294" y="342" width="206" height="50" as="geometry" /></mxCell>
        <mxCell id="tb1" value="&lt;span style=&quot;font-size:9.5px;color:#777777&quot;&gt;OC Dice&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;color:#1f4e8c&quot;&gt;0.8937&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fcfcfc;strokeColor=#d9d9d9;" vertex="1" parent="1"><mxGeometry x="506" y="342" width="206" height="50" as="geometry" /></mxCell>
        <mxCell id="tb2" value="&lt;span style=&quot;font-size:9.5px;color:#777777&quot;&gt;vCDR MAE&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;color:#1f4e8c&quot;&gt;0.0347&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fcfcfc;strokeColor=#d9d9d9;" vertex="1" parent="1"><mxGeometry x="718" y="342" width="206" height="50" as="geometry" /></mxCell>
        <mxCell id="ev" value="&lt;span style=&quot;font-size:10.5px;color:#3a3a3a&quot;&gt; &amp;gt; 在 REFUGE 上，该方法取得 OD Dice 0.9645、OC Dice 0.8937，vCDR MAE 0.0347。&amp;nbsp;&amp;nbsp;^q-8f3a&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;color:#8a7a52&quot;&gt; — Gao et al. 2024, Table 3, p.5&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe8;strokeColor=#e8d49a;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="294" y="408" width="642" height="84" as="geometry" /></mxCell>
        <mxCell id="evtag" value="&lt;span style=&quot;font-size:9px;color:#a08a4a&quot;&gt;引文块 · 可跳转&lt;/span&gt;" style="text;html=1;align=right;verticalAlign=middle;fontSize=9;fontColor=#a08a4a;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="800" y="412" width="130" height="18" as="geometry" /></mxCell>
        <mxCell id="s6h" value="⑥ 局限（我的判断）" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1a1a1a;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="294" y="506" width="642" height="20" as="geometry" /></mxCell>
        <mxCell id="s6" value="单中心校准；未报告跨设备泛化；OC 边界依赖椭圆假设，对切迹与血管遮挡不敏感。" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="294" y="526" width="642" height="34" as="geometry" /></mxCell>
        <mxCell id="s7h" value="⑦ 与我的课题" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1a1a1a;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="294" y="572" width="642" height="20" as="geometry" /></mxCell>
        <mxCell id="s7" value="最强对照基线：OC Dice 0.8937 高于我当前 0.82，vCDR MAE 0.0347 是我要打的目标。未开源，复现性待查。" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="294" y="592" width="642" height="52" as="geometry" /></mxCell>

<mxCell id="t1" value="文献研究 Agent · 从一篇论文到一张知识图谱" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontColor=#1a1a1a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1000" height="42" as="geometry" /></mxCell>
        <mxCell id="t2" value="插件服务端跑管线，结果落成本地 Markdown；Obsidian 只是另一种可选的看法" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1200" height="24" as="geometry" /></mxCell>
        <mxCell id="b1" value="① 入库管线 · 插件服务端（Node）" style="swimlane;startSize=34;html=1;fillColor=#ffffff;strokeColor=#bfbfbf;fontSize=13;fontStyle=1;fontColor=#444444;verticalAlign=middle;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="104" width="1420" height="210" as="geometry" /></mxCell>
        <mxCell id="s1" value="&lt;b style=&quot;font-size:13px&quot;&gt;收文&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444444&quot;&gt;拖入 PDF · 监控文件夹 · DOI/arXiv 链接&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="b1"><mxGeometry x="18" y="50" width="212" height="110" as="geometry" /></mxCell>
        <mxCell id="s2" value="&lt;b style=&quot;font-size:13px&quot;&gt;识别补全&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444444&quot;&gt;sha256 去重 · DOI 对齐 · 补元数据&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="b1"><mxGeometry x="246" y="50" width="212" height="110" as="geometry" /></mxCell>
        <mxCell id="s3" value="&lt;b style=&quot;font-size:13px&quot;&gt;三轴归类&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444444&quot;&gt;体裁 · 主题 · 角色，受控词表&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="b1"><mxGeometry x="474" y="50" width="212" height="110" as="geometry" /></mxCell>
        <mxCell id="s4" value="&lt;b style=&quot;font-size:13px&quot;&gt;解析精读&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444444&quot;&gt;章节切分 → 七段式卡片&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="b1"><mxGeometry x="702" y="50" width="212" height="110" as="geometry" /></mxCell>

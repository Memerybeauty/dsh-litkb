        <mxCell id="b2" value="② 本地库文件夹 · 文件即数据库，Obsidian 可选" style="swimlane;startSize=34;html=1;fillColor=#ffffff;strokeColor=#bfbfbf;fontSize=13;fontStyle=1;fontColor=#444444;verticalAlign=middle;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="1420" height="232" as="geometry" /></mxCell>
